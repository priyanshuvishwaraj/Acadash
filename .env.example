# Copy to .env, choose credentials, and run npm run admin once.
ADMIN_USERNAME=campus-admin
ADMIN_PASSWORD=

PORT=4000
HOST=0.0.0.0
# For HTTPS hosting, set NODE_ENV=production and APP_ORIGIN to the exact public origin.
# NODE_ENV=production
# APP_ORIGIN=https://campus.example.edu
# Use persistent disk paths on a hosted server (not temporary/serverless storage).
# DATABASE_PATH=/var/lib/campus-hub/hub.sqlite
# UPLOAD_DIR=/var/lib/campus-hub/uploads

# Cloud mode: set BOTH to use Supabase instead of the local Express API.
# These are public browser settings. Never use a secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
